{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
  ],
  dependencyDashboard: {
    enabled: true,
  },
  'pre-commit': {
    enabled: true,
  },
  gitIgnoredAuthors: [
    '245757523+pt-release-please[bot]@users.noreply.github.com',
  ],
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^charts/pelostage/Chart\\.yaml$/',
      ],
      matchStrings: [
        'appVersion: (?<currentValue>v\\d+\\.\\d+\\.\\d+)',
      ],
      datasourceTemplate: 'docker',
      depNameTemplate: 'ghcr.io/pelotech/pelostage',
    },
  ],
  packageRules: [
    {
      matchDepNames: [
        'ghcr.io/pelotech/pelostage',
      ],
      semanticCommitType: 'fix',
    },
  ],
}
